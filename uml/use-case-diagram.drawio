<mxfile host="app.diagrams.net" agent="Mozilla/5.0" version="31.1.8">
  <diagram id="vaccination-usecase" name="Use-Case Diagram">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- System boundary -->
        <mxCell id="system" value="Vaccination Cohort &amp;amp; Dose Scheduling System" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;verticalAlign=top;align=center;fontSize=16;fontStyle=1;spacingTop=10;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="280" y="70" width="1040" height="560" as="geometry"/>
        </mxCell>

        <!-- Actors, vertically centred on the shared use case -->
        <mxCell id="citizen" value="Citizen Registrant" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=14;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="140" y="345" width="70" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="officer" value="Vaccination Officer" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=14;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1390" y="345" width="70" height="140" as="geometry"/>
        </mxCell>

        <!-- Citizen Registrant use cases (left column) -->
        <mxCell id="uc1" value="Register /&#10;Maintain Profile" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="330" y="120" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="uc2" value="Book Vaccination Slot" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="330" y="250" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="uc4" value="View Vaccination&#10;Certificate" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="330" y="510" width="230" height="70" as="geometry"/>
        </mxCell>

        <!-- Shared use cases (middle column) -->
        <mxCell id="uc3" value="Check Dose Eligibility" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="650" y="250" width="250" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="uc6" value="Verify QR Certificate" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="650" y="380" width="250" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="uc5" value="Download QR&#10;Certificate" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="650" y="510" width="250" height="70" as="geometry"/>
        </mxCell>

        <!-- Vaccination Officer use cases (right column) -->
        <mxCell id="uc7" value="Manage Vaccination&#10;Slots" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="990" y="120" width="250" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="uc8" value="Record Vaccination&#10;Dose" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="990" y="250" width="250" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="uc9" value="Generate Vaccination&#10;Certificate" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=14;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="990" y="510" width="250" height="70" as="geometry"/>
        </mxCell>

        <!-- Associations: Citizen Registrant -->
        <mxCell id="a1" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="citizen" target="uc1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a2" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="citizen" target="uc2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a3" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="citizen" target="uc4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Shared use case: BOTH actors associate with Verify QR Certificate -->
        <mxCell id="a4" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="citizen" target="uc6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a5" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#000000;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="officer" target="uc6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Associations: Vaccination Officer -->
        <mxCell id="a6" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#000000;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="officer" target="uc7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a7" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#000000;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="officer" target="uc8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a8" style="html=1;endArrow=none;strokeWidth=1.5;strokeColor=#000000;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="officer" target="uc9">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Shared include: BOTH actors' primary use cases include Check Dose Eligibility -->
        <mxCell id="inc1" value="&#171;include&#187;" style="html=1;dashed=1;dashPattern=8 6;endArrow=block;endFill=0;strokeWidth=1.5;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc2" target="uc3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="inc2" value="&#171;include&#187;" style="html=1;dashed=1;dashPattern=8 6;endArrow=block;endFill=0;strokeWidth=1.5;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc8" target="uc3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- extend: arrow points FROM extending use case TO base -->
        <mxCell id="ext1" value="&#171;extend&#187;" style="html=1;dashed=1;dashPattern=8 6;endArrow=block;endFill=0;strokeWidth=1.5;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc5" target="uc4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
